{
  "enabled": {"description": "总开关", "type": "bool", "default": true},
  "client": {"description": "IndexTTS API", "type": "object", "items": {
    "base_url": {"description": "API 地址", "type": "string", "default": "http://127.0.0.1:8000"},
    "api_key": {"description": "API 密钥", "type": "string", "default": ""},
    "connect_timeout": {"description": "连接超时（秒）", "type": "float", "default": 10},
    "request_timeout": {"description": "请求超时（秒）", "type": "float", "default": 300},
    "max_response_mb": {"description": "最大响应（MB）", "type": "int", "default": 50}
  }},
  "tts": {"description": "合成默认值", "type": "object", "items": {
    "speaker_audio": {"description": "服务器端音色参考相对路径", "type": "string", "default": "voices/subaru.wav"},
    "default_language": {"description": "默认语言", "type": "string", "options": ["ZH", "EN", "JA", "AR", "ES"], "default": "ZH"},
    "default_emotion_weight": {"description": "默认情感权重", "type": "float", "default": 0.8},
    "duration_factor": {"description": "时长系数", "type": "float", "default": 1.0},
    "max_text_length": {"description": "最大文本长度", "type": "int", "default": 200}
  }},
  "auto": {"description": "自动回复转语音", "type": "object", "items": {
    "enabled": {"description": "启用", "type": "bool", "default": false},
    "only_llm_result": {"description": "仅 LLM 结果", "type": "bool", "default": true},
    "tts_probability": {"description": "触发概率", "type": "float", "default": 0.15},
    "min_text_length": {"description": "最小文本长度", "type": "int", "default": 5},
    "max_text_length": {"description": "最大文本长度", "type": "int", "default": 100},
    "strip_markdown": {"description": "移除 Markdown", "type": "bool", "default": true}
  }},
  "emotion": {"description": "情感选择", "type": "object", "items": {
    "control_mode": {"description": "控制模式（参考音频控制 / 向量控制）", "type": "string", "options": ["reference_audio", "vector"], "default": "reference_audio"},
    "selection_mode": {"description": "选择方式", "type": "string", "options": ["off", "keyword", "llm"], "default": "llm"},
    "provider_id": {"description": "语言/情感判断 Provider", "type": "string", "default": "", "_special": "select_provider"},
    "judge_timeout": {"description": "语言/情感判断超时（秒）", "type": "float", "default": 20},
    "fallback_to_keyword": {"description": "失败时关键词回退", "type": "bool", "default": true},
    "entries": {"description": "参考音频情感条目", "type": "template_list", "condition": {"control_mode": "reference_audio"}, "default": [
      {"__template_key": "default", "name": "开心", "keywords": ["开心", "哈哈", "太棒了"], "emotion_audio": "emotions/subaru_happy.wav", "emotion_weight": 0.8}
    ], "templates": {"default": {"name": "参考音频情感", "items": {
      "name": {"description": "名称", "type": "string", "default": "请输入情感名"},
      "keywords": {"description": "关键词", "type": "list", "default": []},
      "emotion_audio": {"description": "服务器端情感参考相对路径", "type": "string", "default": ""},
      "emotion_weight": {"description": "情感权重", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.8}
    }}}},
    "vector_entries": {"description": "向量情感条目", "type": "template_list", "condition": {"control_mode": "vector"}, "default": [
      {"__template_key": "default", "name": "开心", "keywords": ["开心", "哈哈", "太棒了"], "emotion_weight": 0.8, "happy": 0.6, "angry": 0.0, "sad": 0.0, "afraid": 0.0, "disgusted": 0.0, "melancholic": 0.0, "surprised": 0.2, "calm": 0.0},
      {"__template_key": "default", "name": "平静", "keywords": ["平静"], "emotion_weight": 0.8, "happy": 0.05, "angry": 0.0, "sad": 0.05, "afraid": 0.0, "disgusted": 0.0, "melancholic": 0.1, "surprised": 0.0, "calm": 0.6},
      {"__template_key": "default", "name": "紧张", "keywords": ["紧张"], "emotion_weight": 0.8, "happy": 0.0, "angry": 0.35, "sad": 0.0, "afraid": 0.2, "disgusted": 0.0, "melancholic": 0.0, "surprised": 0.25, "calm": 0.0},
      {"__template_key": "default", "name": "难过", "keywords": ["难过"], "emotion_weight": 0.8, "happy": 0.0, "angry": 0.0, "sad": 0.45, "afraid": 0.0, "disgusted": 0.0, "melancholic": 0.25, "surprised": 0.0, "calm": 0.1}
    ], "templates": {"default": {"name": "向量情感", "items": {
      "name": {"description": "名称", "type": "string", "default": "请输入情感名"},
      "keywords": {"description": "关键词", "type": "list", "default": []},
      "emotion_weight": {"description": "情感权重", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.8},
      "happy": {"description": "喜", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0},
      "angry": {"description": "怒", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0},
      "sad": {"description": "哀", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0},
      "afraid": {"description": "惧", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0},
      "disgusted": {"description": "厌恶", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0},
      "melancholic": {"description": "低落", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0},
      "surprised": {"description": "惊喜", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0},
      "calm": {"description": "平静", "type": "float", "min": 0, "max": 1, "step": 0.05, "default": 0.0}
    }}}}
  }},
  "cache": {"description": "本地缓存", "type": "object", "items": {
    "enabled": {"description": "启用", "type": "bool", "default": true},
    "expire_hours": {"description": "过期小时数（0 为永不过期）", "type": "int", "default": 24},
    "path": {"description": "缓存路径（留空使用插件数据目录）", "type": "string", "default": ""},
    "max_files": {"description": "最多文件数（0 为不限）", "type": "int", "default": 500},
    "namespace": {"description": "缓存命名空间", "type": "string", "default": "v1"}
  }},
  "tool": {"description": "LLM Tool", "type": "object", "items": {
    "enabled": {"description": "启用 Tool", "type": "bool", "default": true},
    "allow_language_argument": {"description": "允许语言参数", "type": "bool", "default": true}
  }},
  "phonetic": {"description": "注音替换（IndexTTS 多音字/生僻字）", "type": "object", "items": {
    "entries": {"description": "注音替换条目: 字 | 语言 | 注音", "type": "template_list", "default": [], "templates": {"default": {"name": "注音替换", "items": {
      "char": {"description": "字符/词（需注音的汉字或词）", "type": "string", "default": ""},
      "language": {"description": "生效语言", "type": "string", "options": ["ZH", "JA", "EN"], "default": "ZH"},
      "phonetic": {"description": "注音\nZH: 拼音如 MAO3\nJA: 假名如 じょうず\nEN: [音标片段](https://svn.code.sf.net/p/cmusphinx/code/trunk/cmudict/cmudict-0.7b)", "type": "string", "default": ""}
    }}}}
  }}
}
